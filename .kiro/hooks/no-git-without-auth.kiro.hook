{
  "enabled": true,
  "name": "No commit/push sin autorización",
  "description": "Antes de ejecutar cualquier comando git commit o git push, pide autorización explícita al usuario. Nunca commitear ni pushear sin confirmación previa.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "shell"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check if the command contains 'git commit' or 'git push'. If it does, review the LAST message from the user in the conversation. If the user explicitly said 'adelante', 'yes', 'sí', 'dale', 'ok', 'push', 'commit y push', or any clear authorization in their most recent message, then PROCEED with the command — do not block it. Only block and ask for permission if there is NO prior authorization from the user in the current exchange."
  }
}